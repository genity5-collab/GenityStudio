# Set these only in Render’s encrypted environment settings. Never commit real values.
APP_ENV=production
PUBLIC_BASE_URL=https://your-render-service.onrender.com
APP_SESSION_SECRET=generate-a-random-32-byte-or-longer-value
DEVICE_HASH_PEPPER=generate-a-separate-random-value
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
ROBLOX_OPEN_CLOUD_API_KEY=server-only-creator-store-key
# Compatibility alias: use this only if your existing Render service already
# stores the Roblox secret under this name. Configure one name, not both.
ROBLOX_API_KEY=optional-server-only-creator-store-key
# Configure only providers you intend to offer; the browser never receives these.
AI_GEMINI_API_KEY=server-only-gemini-key
AI_OPENAI_API_KEY=server-only-openai-key
AI_ANTHROPIC_API_KEY=server-only-anthropic-key
AI_XAI_API_KEY=server-only-xai-key
AI_QWEN_API_KEY=server-only-qwen-key
AI_MISTRAL_API_KEY=server-only-mistral-key
AI_MOONSHOT_API_KEY=server-only-moonshot-key
AI_GROQ_API_KEY=server-only-groq-key
# Optional, only required for adaptive high-risk verification:
TURNSTILE_SECRET_KEY=turnstile-secret
CORS_ALLOWED_ORIGINS=https://your-render-service.onrender.com
